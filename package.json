{
  "name": "@local/agent-chirp",
  "version": "1.1.0",
  "description": "Gentle musical chirps while the DeepSeek Harness agent works — different sounds for thinking, answering, and tool use.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxbc/agent-chirp.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "audio",
    "sound",
    "webaudio",
    "agent"
  ],
  "author": "zxbc",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
